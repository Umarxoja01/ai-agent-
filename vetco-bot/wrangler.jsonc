{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "vetco-bot",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "observability": { "enabled": true },

  // npx wrangler d1 create vetco-bot  ->  paste the printed database_id here
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "vetco-bot",
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations"
    }
  ],

  // 03:00 UTC = 08:00 Tashkent: catalog sync from Google Sheets.
  // Every 15 min: re-send order cards / sheet rows that failed earlier.
  "triggers": { "crons": ["0 3 * * *", "*/15 * * * *"] },

  // Not secret. Secrets (BOT_TOKEN, WEBHOOK_SECRET, ADMIN_TOKEN, SHEETS_WEBHOOK_URL,
  // SHEETS_WEBHOOK_KEY) go in with `npx wrangler secret put NAME`, never into this file.
  "vars": {
    "ADMIN_CHAT_ID": "",
    "ADMIN_USER_IDS": "",
    "BOT_USERNAME": "",
    "CATALOG_CSV_URL": "",
    "PAYME_URL": "",
    "CLICK_URL": "",
    "CONTACT_PHONE": "",
    "CONTACT_TEXT_UZ": "",
    "CONTACT_TEXT_RU": ""
  }
}
